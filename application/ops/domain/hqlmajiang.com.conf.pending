# Enable only after ICP approval and certificate installation.
# Include within nginx http context. All mutable files live on /data.
server {
    listen 80;
    server_name hqlmajiang.com www.hqlmajiang.com;
    access_log /data/majiang/prod/logs/domain-access.log;
    error_log /data/majiang/prod/logs/domain-error.log;
    location ^~ /.well-known/acme-challenge/ {
        root /data/majiang/prod/data/acme;
    }
    location / { return 301 https://hqlmajiang.com$request_uri; }
}
server {
    listen 443 ssl;
    server_name www.hqlmajiang.com;
    ssl_certificate /data/majiang/prod/config/tls/fullchain.pem;
    ssl_certificate_key /data/majiang/prod/config/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    return 301 https://hqlmajiang.com$request_uri;
}
server {
    listen 443 ssl;
    server_name hqlmajiang.com;
    ssl_certificate /data/majiang/prod/config/tls/fullchain.pem;
    ssl_certificate_key /data/majiang/prod/config/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 6m;
    client_body_temp_path /data/majiang/prod/tmp/nginx-body;
    proxy_temp_path /data/majiang/prod/tmp/nginx-proxy;
    access_log /data/majiang/prod/logs/domain-access.log;
    error_log /data/majiang/prod/logs/domain-error.log;
    location / {
        proxy_pass http://127.0.0.1:8771;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 60s;
    }
}
